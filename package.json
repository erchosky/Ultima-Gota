{
  "name": "ultima-gota",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18 <23"
  },
  "scripts": {
    "build": "vite build --config vite.classroom.config.ts && vite build --config vite.storefront.config.ts",
    "typecheck": "tsc --noEmit",
    "start": "tsx scripts/start.ts",
    "dev": "npm run build && npm start",
    "test:integration": "tsx --test tests/scenario-validation/*.test.ts",
    "test:browser": "tsx tests/learning-flows/act-one.ts",
    "test:design": "python3 scripts/check_design.py",
    "test:browser:act-two": "tsx tests/learning-flows/act-two.ts",
    "test:browser:all": "npm run test:browser && npm run test:browser:act-two && npm run test:browser:act-three && npm run test:browser:act-four",
    "test:browser:act-three": "tsx tests/learning-flows/act-three.ts",
    "test:browser:act-four": "tsx tests/learning-flows/act-four.ts"
  },
  "dependencies": {
    "express": "5.3.0",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
